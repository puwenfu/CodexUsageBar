<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="QuotaProgressBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F2FFDE" />
        <GradientStop Offset="0.52" Color="#73ECD6" />
        <GradientStop Offset="1" Color="#8296F0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="QuotaRefreshHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FAFFF1" />
        <GradientStop Offset="0.52" Color="#A4F5E6" />
        <GradientStop Offset="1" Color="#ABB8FF" />
    </LinearGradientBrush>
</ResourceDictionary>
