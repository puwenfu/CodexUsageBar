<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="QuotaProgressBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#AAB8FF" />
        <GradientStop Offset="0.52" Color="#747EFF" />
        <GradientStop Offset="1" Color="#5E63FF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="QuotaRefreshHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#D8DEFF" />
        <GradientStop Offset="0.52" Color="#AAB2FF" />
        <GradientStop Offset="1" Color="#8589FF" />
    </LinearGradientBrush>
</ResourceDictionary>
