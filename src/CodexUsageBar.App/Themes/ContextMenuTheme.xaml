<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CodexUsageBar.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="ContextMenuFontFamily">Microsoft YaHei UI</FontFamily>
    <Thickness x:Key="ContextMenuItemPadding">8,6,6,6</Thickness>
    <Thickness x:Key="ContextSubmenuItemPadding">8,6,2,6</Thickness>
    <Thickness x:Key="ContextMenuOuterPadding">2</Thickness>
    <Thickness x:Key="ContextMenuItemMargin">1</Thickness>
    <GridLength x:Key="ContextMenuIconColumnWidth">18</GridLength>
    <sys:Double x:Key="ContextMenuMinWidth">180</sys:Double>
    <sys:Double x:Key="ContextSubmenuMinWidth">116</sys:Double>

    <DataTemplate x:Key="ColorThemeHeaderTemplate">
        <TextBlock Margin="2,0,0,0"
                   Text="{Binding}" />
    </DataTemplate>

    <Style x:Key="CompactToggleTrackStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="23.8" />
        <Setter Property="Height" Value="13.6" />
        <Setter Property="Background" Value="{DynamicResource ContextMenuToggleTrackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContextMenuToggleBorderBrush}" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="CornerRadius" Value="6.8" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="3"
                                  ShadowDepth="0.7"
                                  Direction="270"
                                  Opacity="{DynamicResource ContextMenuShadowOpacity}"
                                  Color="{DynamicResource ContextMenuShadowColor}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactToggleThumbStyle" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="1.8" />
        <Setter Property="Fill" Value="{DynamicResource ContextMenuToggleThumbBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="2"
                                  ShadowDepth="0.6"
                                  Direction="270"
                                  Opacity="{DynamicResource ContextMenuShadowOpacity}"
                                  Color="{DynamicResource ContextMenuShadowColor}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Geometry x:Key="MenuRefreshIcon">M11.8,6.8 A5,5 0 1 1 10.2,3 M10.2,0.9 V3.5 H7.6</Geometry>
    <Geometry x:Key="MenuThemeIcon">M7,1.2 C3.6,1.2 1,3.7 1,7 C1,10.4 3.7,13 7.1,13 H8.2 C9,13 9.6,12.5 9.6,11.8 C9.6,11.1 9,10.6 8.3,10.6 H7.5 C6.8,10.6 6.3,10.1 6.3,9.4 C6.3,8.7 6.9,8.2 7.6,8.2 H10.7 C12.3,8.2 13.2,7.1 13.2,5.7 C13.2,3.2 10.7,1.2 7,1.2 Z M4,5.8 L4.01,5.8 M6,3.8 L6.01,3.8 M9,3.6 L9.01,3.6 M11.2,5.3 L11.21,5.3</Geometry>
    <Geometry x:Key="MenuRefreshStyleIcon">M7,1 L8.1,4.9 12,6 8.1,7.1 7,11 5.9,7.1 2,6 5.9,4.9 Z M11,1.5 L11.4,2.6 12.5,3 11.4,3.4 11,4.5 10.6,3.4 9.5,3 10.6,2.6 Z</Geometry>
    <Geometry x:Key="MenuPlacementIcon">M2,2.2 H12 V8.2 H2 Z M5,11.8 H9 M7,8.2 V11.8 M10.2,5.2 L12.8,7.8 M12.8,7.8 L10.2,10.4</Geometry>
    <Geometry x:Key="MenuHideIcon">M1,7 C3.7,3.2 10.3,3.2 13,7 C10.3,10.8 3.7,10.8 1,7 M4,3.4 L10.6,10.6</Geometry>
    <Geometry x:Key="MenuStartupIcon">F0 M4.2,9.6 C5.1,6.6 8.4,3.1 12.7,1.5 C12.4,5.9 9.1,9.3 6.1,10.2 Z M8.7,5.2 A1.2,1.2 0 1 0 11.1,5.2 A1.2,1.2 0 1 0 8.7,5.2 Z M5.2,6.8 L2.5,6.6 4.5,4.8 7.2,4.5 Z M8.8,8.2 L8.5,11 6.5,13 6.3,9.7 Z M4.6,9.8 C3.6,10.2 2.4,11.4 2,13 C3.6,12.6 4.9,11.5 5.3,10.4 Z</Geometry>
    <Geometry x:Key="MenuDebugIcon">M4,4 H10 V11 H4 Z M5,2 H9 M2,5.5 H4 M10,5.5 H12 M2,9 H4 M10,9 H12</Geometry>
    <Geometry x:Key="MenuAboutIcon">M7,1.2 A5.8,5.8 0 1 1 6.99,1.2 M7,6 V10 M7,4 V4.1</Geometry>
    <Geometry x:Key="MenuExitIcon">M7,1 V6 M3.5,3.5 A5,5 0 1 0 10.5,3.5</Geometry>

    <Style x:Key="CodexMenuIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="11.2" />
        <Setter Property="Height" Value="11.2" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke"
                Value="{Binding Path=(controls:MenuChrome.IconBrush),
                                RelativeSource={RelativeSource Self}}" />
        <Setter Property="StrokeThickness" Value="1.08" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CodexMenuFilledIconStyle"
           TargetType="{x:Type Path}"
           BasedOn="{StaticResource CodexMenuIconStyle}">
        <Setter Property="Width" Value="12.4" />
        <Setter Property="Height" Value="12.4" />
        <Setter Property="Fill"
                Value="{Binding Path=(controls:MenuChrome.IconBrush),
                                RelativeSource={RelativeSource Self}}" />
        <Setter Property="Stroke" Value="{x:Null}" />
    </Style>

    <Style x:Key="CodexContextMenuStyle" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource ContextMenuSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContextMenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ContextMenuSecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ContextMenuFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="{StaticResource ContextMenuMinWidth}" />
        <Setter Property="Padding" Value="{StaticResource ContextMenuOuterPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid>
                        <Border x:Name="ContextMenuPanel"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Margin="12"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="4"
                                                  Opacity="{DynamicResource ContextMenuShadowOpacity}"
                                                  Color="{DynamicResource ContextMenuShadowColor}" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ContextMenuContentHost"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="18,4,6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1"
                            Background="{DynamicResource ContextMenuDividerBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexAboutItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource ContextMenuSecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ContextMenuFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border Padding="13,12,15,12"
                            Background="Transparent">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource ContextMenuSecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ContextMenuFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="{StaticResource ContextMenuItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="ItemBackground"
                                Background="Transparent"
                                CornerRadius="5"
                                Margin="{StaticResource ContextMenuItemMargin}" />
                        <Border x:Name="ItemContentHost"
                                Background="Transparent"
                                Margin="{StaticResource ContextMenuItemMargin}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ContextMenuIconColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="23.8" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  controls:MenuChrome.IconBrush="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <Border x:Name="ToggleSwitch"
                                        Grid.Column="2"
                                        Style="{StaticResource CompactToggleTrackStyle}"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Ellipse x:Name="ToggleThumb"
                                                 Style="{StaticResource CompactToggleThumbStyle}" />
                                    </Grid>
                                </Border>
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="2"
                                      Width="6"
                                      Height="10"
                                      Data="M1,1 L5,5 L1,9"
                                      Stroke="{DynamicResource ContextMenuSecondaryTextBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                                <Path x:Name="ChoiceCheck"
                                      Grid.Column="2"
                                      Width="10"
                                      Height="8"
                                      Data="M1,4 L3.7,6.7 L9,1"
                                      Stroke="{DynamicResource ContextMenuStatusBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <controls:RightPreferredPopup x:Name="PART_Popup"
                                                      PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      IsOpen="{TemplateBinding IsSubmenuOpen}"
                                                      AllowsTransparency="True"
                                                      Focusable="False"
                                                      PopupAnimation="Fade">
                            <Grid>
                                <Border x:Name="SubmenuSurface"
                                        Background="{DynamicResource ContextMenuSurfaceBrush}"
                                        BorderBrush="{DynamicResource ContextMenuBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Margin="2,12,12,12"
                                        MinWidth="{StaticResource ContextSubmenuMinWidth}"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16"
                                                          ShadowDepth="4"
                                                          Opacity="{DynamicResource ContextMenuShadowOpacity}"
                                                          Color="{DynamicResource ContextMenuShadowColor}" />
                                    </Border.Effect>
                                </Border>
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="2,12,12,12"
                                              Padding="{StaticResource ContextMenuOuterPadding}">
                                    <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" />
                                </ScrollViewer>
                            </Grid>
                        </controls:RightPreferredPopup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{DynamicResource ContextMenuHoverBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ContextMenuPrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Toggle">
                            <Setter TargetName="ToggleSwitch"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="Tag" Value="Toggle" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ToggleSwitch"
                                    Property="Background"
                                    Value="{DynamicResource ContextMenuStatusBrush}" />
                            <Setter TargetName="ToggleThumb"
                                    Property="Fill"
                                    Value="{DynamicResource ContextMenuToggleCheckedThumbBrush}" />
                            <Setter TargetName="ToggleThumb"
                                    Property="HorizontalAlignment"
                                    Value="Right" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="Tag" Value="Theme" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{DynamicResource ContextMenuHoverBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ContextMenuPrimaryTextBrush}" />
                            <Setter TargetName="ChoiceCheck"
                                    Property="Visibility"
                                    Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Exit">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ContextMenuExitBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True" />
                                <Condition Property="Tag" Value="Exit" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ContextMenuExitHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexToolTipStyle" TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource ContextMenuSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContextMenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ContextMenuPrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ContextMenuFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CodexSliderDecreaseButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="4"
                            Background="{DynamicResource QuotaProgressBrush}"
                            CornerRadius="2"
                            VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexSliderIncreaseButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="4"
                            Background="{DynamicResource ContextMenuBorderBrush}"
                            CornerRadius="2"
                            VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Ellipse Fill="{DynamicResource QuotaProgressBrush}"
                             Stroke="{DynamicResource ContextMenuPrimaryTextBrush}"
                             StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid>
                        <Track x:Name="PART_Track"
                               VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                              Style="{StaticResource CodexSliderDecreaseButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                              Style="{StaticResource CodexSliderIncreaseButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource CodexSliderThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
