<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CodexUsageBar.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="ContextMenuFontFamily">Microsoft YaHei UI</FontFamily>
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#434343" />
    <SolidColorBrush x:Key="ContextMenuHoverBrush" Color="#3B3B3B" />
    <SolidColorBrush x:Key="ContextMenuDividerBrush" Color="#353535" />
    <SolidColorBrush x:Key="ContextMenuPrimaryTextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ContextMenuSecondaryTextBrush" Color="#9D9D9D" />
    <SolidColorBrush x:Key="ContextMenuStatusBrush" Color="#A8FF7A" />
    <SolidColorBrush x:Key="ContextMenuExitBrush" Color="#C85A5A" />
    <SolidColorBrush x:Key="ContextMenuExitHoverBrush" Color="#EF6D6D" />
    <LinearGradientBrush x:Key="ContextMenuSurfaceBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#F027292E" />
        <GradientStop Offset="0.58" Color="#F01A1B1F" />
        <GradientStop Offset="1" Color="#F017181B" />
    </LinearGradientBrush>
    <Thickness x:Key="ContextMenuItemPadding">8,6,6,6</Thickness>
    <Thickness x:Key="ContextSubmenuItemPadding">8,6,2,6</Thickness>
    <Thickness x:Key="ContextMenuOuterPadding">2</Thickness>
    <Thickness x:Key="ContextMenuItemMargin">1</Thickness>
    <GridLength x:Key="ContextMenuIconColumnWidth">18</GridLength>
    <sys:Double x:Key="ContextMenuMinWidth">180</sys:Double>
    <sys:Double x:Key="ContextSubmenuMinWidth">116</sys:Double>

    <Geometry x:Key="MenuRefreshIcon">M11.8,6.8 A5,5 0 1 1 10.2,3 M10.2,0.9 V3.5 H7.6</Geometry>
    <Geometry x:Key="MenuThemeIcon">M2,2 H6 V6 H2 Z M8,2 H12 V6 H8 Z M2,8 H6 V12 H2 Z M8,8 H12 V12 H8 Z</Geometry>
    <Geometry x:Key="MenuHideIcon">M1,7 C3.7,3.2 10.3,3.2 13,7 C10.3,10.8 3.7,10.8 1,7 M4,3.4 L10.6,10.6</Geometry>
    <Geometry x:Key="MenuStartupIcon">M7,1 V6 M3.7,3.4 A5,5 0 1 0 10.3,3.4</Geometry>
    <Geometry x:Key="MenuDebugIcon">M4,4 H10 V11 H4 Z M5,2 H9 M2,5.5 H4 M10,5.5 H12 M2,9 H4 M10,9 H12</Geometry>
    <Geometry x:Key="MenuAboutIcon">M7,1.2 A5.8,5.8 0 1 1 6.99,1.2 M7,6 V10 M7,4 V4.1</Geometry>
    <Geometry x:Key="MenuExitIcon">M7,1 V6 M3.5,3.5 A5,5 0 1 0 10.5,3.5</Geometry>

    <Style x:Key="CodexMenuIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke"
                Value="{Binding Path=(controls:MenuChrome.IconBrush),
                                RelativeSource={RelativeSource Self}}" />
        <Setter Property="StrokeThickness" Value="1.35" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CodexContextMenuStyle" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{StaticResource ContextMenuSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ContextMenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ContextMenuSecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ContextMenuFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="{StaticResource ContextMenuMinWidth}" />
        <Setter Property="Padding" Value="{StaticResource ContextMenuOuterPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid>
                        <Border x:Name="ContextMenuPanel"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Margin="12"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="4"
                                                  Opacity="0.25"
                                                  Color="#000000" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ContextMenuContentHost"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="18,4,6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1"
                            Background="{StaticResource ContextMenuDividerBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexAboutItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource ContextMenuSecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ContextMenuFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border Padding="13,12,15,12"
                            Background="Transparent">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource ContextMenuSecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ContextMenuFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="{StaticResource ContextMenuItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="ItemBackground"
                                Background="Transparent"
                                CornerRadius="5"
                                Margin="{StaticResource ContextMenuItemMargin}" />
                        <Border x:Name="ItemContentHost"
                                Background="Transparent"
                                Margin="{StaticResource ContextMenuItemMargin}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ContextMenuIconColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  controls:MenuChrome.IconBrush="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <Ellipse x:Name="StatusDot"
                                         Grid.Column="2"
                                         Width="7"
                                         Height="7"
                                         Fill="{DynamicResource QuotaProgressBrush}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="2"
                                      Width="6"
                                      Height="10"
                                      Data="M1,1 L5,5 L1,9"
                                      Stroke="{StaticResource ContextMenuSecondaryTextBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <controls:RightPreferredPopup x:Name="SubmenuPopup"
                                                      PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      IsOpen="{TemplateBinding IsSubmenuOpen}"
                                                      AllowsTransparency="True"
                                                      Focusable="False"
                                                      PopupAnimation="Fade">
                            <Grid>
                                <Border x:Name="SubmenuSurface"
                                        Background="{StaticResource ContextMenuSurfaceBrush}"
                                        BorderBrush="{StaticResource ContextMenuBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Margin="2,12,12,12"
                                        MinWidth="{StaticResource ContextSubmenuMinWidth}"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16"
                                                          ShadowDepth="4"
                                                          Opacity="0.25"
                                                          Color="#000000" />
                                    </Border.Effect>
                                </Border>
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="2,12,12,12"
                                              Padding="{StaticResource ContextMenuOuterPadding}">
                                    <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" />
                                </ScrollViewer>
                            </Grid>
                        </controls:RightPreferredPopup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{StaticResource ContextMenuHoverBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource ContextMenuPrimaryTextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="Tag" Value="Toggle" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="StatusDot"
                                    Property="Visibility"
                                    Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="Tag" Value="Theme" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{StaticResource ContextMenuHoverBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource ContextMenuPrimaryTextBrush}" />
                        </MultiTrigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Exit">
                            <Setter Property="Foreground"
                                    Value="{StaticResource ContextMenuExitBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True" />
                                <Condition Property="Tag" Value="Exit" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground"
                                    Value="{StaticResource ContextMenuExitHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
