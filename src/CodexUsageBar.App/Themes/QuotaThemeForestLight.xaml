<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="QuotaProgressBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#ECFFCA" />
        <GradientStop Offset="0.52" Color="#DEEF59" />
        <GradientStop Offset="1" Color="#2B8069" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="QuotaRefreshHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F6FFE6" />
        <GradientStop Offset="0.52" Color="#EDFA8E" />
        <GradientStop Offset="1" Color="#67B49A" />
    </LinearGradientBrush>
</ResourceDictionary>
