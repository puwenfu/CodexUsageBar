<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="QuotaTrackBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="QuotaPrimaryTextBrush" Color="#F8F7FC" />
    <SolidColorBrush x:Key="QuotaSecondaryTextBrush" Color="#A9A4B2" />
    <LinearGradientBrush x:Key="ThemeBluePreviewBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#8D9EFC" />
        <GradientStop Offset="0.52" Color="#585EF6" />
        <GradientStop Offset="1" Color="#4E4FF4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemePurplePreviewBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#D4A7FF" />
        <GradientStop Offset="0.52" Color="#9B6CFF" />
        <GradientStop Offset="1" Color="#5B43FF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemeRosePreviewBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF758A" />
        <GradientStop Offset="0.52" Color="#FF657A" />
        <GradientStop Offset="1" Color="#FF4588" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemeMintPreviewBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#EBFFCD" />
        <GradientStop Offset="0.52" Color="#54E3CA" />
        <GradientStop Offset="1" Color="#677FE4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemeForestPreviewBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E0F8BA" />
        <GradientStop Offset="0.52" Color="#D3E52D" />
        <GradientStop Offset="1" Color="#0C6651" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#434343" />
    <SolidColorBrush x:Key="ContextMenuHoverBrush" Color="#3B3B3B" />
    <SolidColorBrush x:Key="ContextMenuDividerBrush" Color="#353535" />
    <SolidColorBrush x:Key="ContextMenuPrimaryTextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ContextMenuSecondaryTextBrush" Color="#9D9D9D" />
    <SolidColorBrush x:Key="ContextMenuMutedTextBrush" Color="#85868B" />
    <SolidColorBrush x:Key="ContextMenuStatusBrush" Color="#A8FF7A" />
    <SolidColorBrush x:Key="ContextMenuToggleTrackBrush" Color="#303036" />
    <SolidColorBrush x:Key="ContextMenuToggleBorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ContextMenuToggleThumbBrush" Color="#85858E" />
    <SolidColorBrush x:Key="ContextMenuToggleCheckedThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ContextMenuExitBrush" Color="#C85A5A" />
    <SolidColorBrush x:Key="ContextMenuExitHoverBrush" Color="#EF6D6D" />
    <SolidColorBrush x:Key="DebugInputBackgroundBrush" Color="#E62D2E33" />
    <LinearGradientBrush x:Key="ContextMenuSurfaceBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#F027292E" />
        <GradientStop Offset="0.58" Color="#F01A1B1F" />
        <GradientStop Offset="1" Color="#F017181B" />
    </LinearGradientBrush>
    <Color x:Key="ContextMenuShadowColor">#000000</Color>
    <sys:Double x:Key="ContextMenuShadowOpacity">0.25</sys:Double>
    <sys:Double x:Key="DebugPanelShadowOpacity">0.28</sys:Double>
</ResourceDictionary>
