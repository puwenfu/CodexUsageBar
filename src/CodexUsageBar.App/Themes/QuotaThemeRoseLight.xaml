<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="QuotaProgressBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF9CAF" />
        <GradientStop Offset="0.52" Color="#FF7E96" />
        <GradientStop Offset="1" Color="#FF63A3" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="QuotaRefreshHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFC5CF" />
        <GradientStop Offset="0.52" Color="#FFABB9" />
        <GradientStop Offset="1" Color="#FF8FBB" />
    </LinearGradientBrush>
</ResourceDictionary>
