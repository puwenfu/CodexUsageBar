<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="WidgetFontFamily">Segoe UI Variable Display</FontFamily>
    <LinearGradientBrush x:Key="QuotaProgressBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF758A" />
        <GradientStop Offset="0.52" Color="#FF657A" />
        <GradientStop Offset="1" Color="#FF4588" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="QuotaRefreshHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFB6C2" />
        <GradientStop Offset="0.52" Color="#FFA0AF" />
        <GradientStop Offset="1" Color="#FF8AAE" />
    </LinearGradientBrush>
</ResourceDictionary>
