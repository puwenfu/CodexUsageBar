<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="QuotaProgressBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E2C8FF" />
        <GradientStop Offset="0.52" Color="#B88CFF" />
        <GradientStop Offset="1" Color="#806CFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="QuotaRefreshHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F1E3FF" />
        <GradientStop Offset="0.52" Color="#D8B9FF" />
        <GradientStop Offset="1" Color="#AA9AFF" />
    </LinearGradientBrush>
</ResourceDictionary>
