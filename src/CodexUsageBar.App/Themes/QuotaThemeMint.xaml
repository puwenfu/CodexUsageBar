<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="WidgetFontFamily">Segoe UI Variable Display</FontFamily>
    <LinearGradientBrush x:Key="QuotaProgressBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#EBFFCD" />
        <GradientStop Offset="0.52" Color="#54E3CA" />
        <GradientStop Offset="1" Color="#677FE4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="QuotaRefreshHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F7FFE9" />
        <GradientStop Offset="0.52" Color="#8CF4E1" />
        <GradientStop Offset="1" Color="#9CABFF" />
    </LinearGradientBrush>
</ResourceDictionary>
