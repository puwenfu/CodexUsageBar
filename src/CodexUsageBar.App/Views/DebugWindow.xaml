<Window x:Class="CodexUsageBar.App.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="调试面板"
        Width="304"
        Height="302"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Background="Transparent"
        Foreground="{DynamicResource QuotaPrimaryTextBrush}"
        FontFamily="{DynamicResource WidgetFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CodexUsageBar.App;component/Themes/ContextMenuTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DebugTitleButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Foreground" Value="{StaticResource ContextMenuSecondaryTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0,-2,0,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground"
                                            Property="Background"
                                            Value="{StaticResource ContextMenuHoverBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{StaticResource ContextMenuPrimaryTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.72" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DebugCheckBoxStyle" TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{StaticResource ContextMenuSecondaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Border x:Name="ToggleBackground"
                                    Background="Transparent"
                                    CornerRadius="5"
                                    Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                    <Ellipse x:Name="StatusDot"
                                             Grid.Column="1"
                                             Width="8"
                                             Height="8"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource ContextMenuStatusBrush}"
                                             Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBackground"
                                            Property="Background"
                                            Value="{StaticResource ContextMenuHoverBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{StaticResource ContextMenuPrimaryTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="StatusDot"
                                            Property="Visibility"
                                            Value="Visible" />
                                    <Setter Property="Foreground"
                                            Value="{StaticResource ContextMenuPrimaryTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DebugSliderDecreaseButtonStyle" TargetType="{x:Type RepeatButton}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Height="4"
                                    Background="{DynamicResource QuotaProgressBrush}"
                                    CornerRadius="2"
                                    VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DebugSliderIncreaseButtonStyle" TargetType="{x:Type RepeatButton}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Height="4"
                                    Background="{StaticResource ContextMenuBorderBrush}"
                                    CornerRadius="2"
                                    VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DebugSliderThumbStyle" TargetType="{x:Type Thumb}">
                <Setter Property="Width" Value="13" />
                <Setter Property="Height" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Ellipse Fill="{DynamicResource QuotaProgressBrush}"
                                     Stroke="{StaticResource ContextMenuPrimaryTextBrush}"
                                     StrokeThickness="1" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DebugSliderStyle" TargetType="{x:Type Slider}">
                <Setter Property="Height" Value="20" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid>
                                <Track x:Name="PART_Track"
                                       VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                      Style="{StaticResource DebugSliderDecreaseButtonStyle}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                      Style="{StaticResource DebugSliderIncreaseButtonStyle}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource DebugSliderThumbStyle}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DebugTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Height" Value="31" />
                <Setter Property="Background" Value="#E62D2E33" />
                <Setter Property="Foreground" Value="{StaticResource ContextMenuPrimaryTextBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource ContextMenuPrimaryTextBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource QuotaProgressBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ContextMenuBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="InputBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="InputBackground"
                                            Property="BorderBrush"
                                            Value="{DynamicResource QuotaProgressBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="InputBackground"
                                            Property="Background"
                                            Value="{StaticResource ContextMenuHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DebugLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ContextMenuSecondaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border x:Name="DebugPanel"
                Width="280"
                Height="278"
                Background="{StaticResource ContextMenuSurfaceBrush}"
                BorderBrush="{StaticResource ContextMenuBorderBrush}"
                BorderThickness="1"
                CornerRadius="11"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="4"
                                  Opacity="0.28"
                                  Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="DebugTitleBar"
                        Background="Transparent"
                        Padding="14,0,8,0"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid>
                        <TextBlock x:Name="DebugTitle"
                                   Text="调试面板"
                                   Foreground="{StaticResource ContextMenuPrimaryTextBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <Button x:Name="CloseButton"
                                Content="×"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource DebugTitleButtonStyle}"
                                Click="OnCloseClick" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="6,0,6,10">
                    <CheckBox x:Name="SimulationToggle"
                              Content="启用模拟数据"
                              IsChecked="{Binding IsEnabled}"
                              Style="{StaticResource DebugCheckBoxStyle}"
                              Margin="0,0,0,4" />

                    <Grid Margin="8,0">
                        <TextBlock Text="5h 额度百分比"
                                   Style="{StaticResource DebugLabelStyle}" />
                        <TextBlock Text="{Binding FiveHourPercentage, StringFormat={}{0}%}"
                                   Foreground="{StaticResource ContextMenuPrimaryTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="FiveHourSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding FiveHourPercentage}"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            Style="{StaticResource DebugSliderStyle}"
                            Margin="8,0,8,4" />

                    <TextBlock Text="5h 提示文字"
                               Style="{StaticResource DebugLabelStyle}"
                               Margin="8,0,8,3" />
                    <TextBox x:Name="FiveHourTextBox"
                             Text="{Binding FiveHourText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DebugTextBoxStyle}"
                             Margin="8,0,8,7" />

                    <Grid Margin="8,0">
                        <TextBlock Text="周额度百分比"
                                   Style="{StaticResource DebugLabelStyle}" />
                        <TextBlock Text="{Binding WeeklyPercentage, StringFormat={}{0}%}"
                                   Foreground="{StaticResource ContextMenuPrimaryTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="WeeklySlider"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding WeeklyPercentage}"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            Style="{StaticResource DebugSliderStyle}"
                            Margin="8,0,8,4" />

                    <TextBlock Text="周额度提示文字"
                               Style="{StaticResource DebugLabelStyle}"
                               Margin="8,0,8,3" />
                    <TextBox x:Name="WeeklyTextBox"
                             Text="{Binding WeeklyText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DebugTextBoxStyle}"
                             Margin="8,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
