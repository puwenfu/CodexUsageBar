<Window x:Class="CodexUsageBar.App.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexUsageBar.App.Controls"
        Title="Codex Usage"
        Width="168"
        MinWidth="1"
        MaxWidth="180"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="False"
        Background="Transparent"
        FontFamily="{DynamicResource WidgetFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CodexUsageBar.App;component/Themes/SystemThemeDark.xaml" />
                <ResourceDictionary Source="/CodexUsageBar.App;component/Themes/ContextMenuTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WidgetRoot"
          Background="Transparent"
          ClipToBounds="True"
          PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
        <Grid.ToolTip>
            <ToolTip x:Name="WidgetToolTip"
                     Content="{Binding Tooltip}"
                     Style="{StaticResource CodexToolTipStyle}" />
        </Grid.ToolTip>
        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource CodexContextMenuStyle}"
                         StaysOpen="False"
                         Opened="OnContextMenuOpened"
                         Closed="OnContextMenuClosed">
                <MenuItem Header="立即刷新"
                          controls:MenuChrome.IsRootItem="True"
                          Style="{StaticResource CodexMenuItemStyle}"
                          Click="OnRefreshMenuClick">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource MenuRefreshIcon}"
                              Style="{StaticResource CodexMenuIconStyle}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="主题颜色"
                          controls:MenuChrome.IsRootItem="True"
                          Style="{StaticResource CodexMenuItemStyle}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource MenuThemeIcon}"
                              Style="{StaticResource CodexMenuIconStyle}" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="ThemeBlueMenuItem"
                              Header="沧海星澜"
                              Tag="Theme"
                              IsCheckable="True"
                              HeaderTemplate="{StaticResource ColorThemeHeaderTemplate}"
                              Padding="{StaticResource ContextSubmenuItemPadding}"
                              Style="{StaticResource CodexMenuItemStyle}"
                              Click="OnThemeBlueClick">
                        <MenuItem.Icon>
                            <Grid Width="11.7"
                                  Height="11.7">
                                <Ellipse Stroke="{DynamicResource QuotaTrackBrush}"
                                         StrokeThickness="1.35" />
                                <controls:ProgressArc Progress="85"
                                                      Stroke="{StaticResource ThemeBluePreviewBrush}"
                                                      StrokeThickness="1.35" />
                            </Grid>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="ThemePurpleMenuItem"
                              Header="暮紫流烟"
                              Tag="Theme"
                              IsCheckable="True"
                              HeaderTemplate="{StaticResource ColorThemeHeaderTemplate}"
                              Padding="{StaticResource ContextSubmenuItemPadding}"
                              Style="{StaticResource CodexMenuItemStyle}"
                              Click="OnThemePurpleClick">
                        <MenuItem.Icon>
                            <Grid Width="11.7"
                                  Height="11.7">
                                <Ellipse Stroke="{DynamicResource QuotaTrackBrush}"
                                         StrokeThickness="1.35" />
                                <controls:ProgressArc Progress="85"
                                                      Stroke="{StaticResource ThemePurplePreviewBrush}"
                                                      StrokeThickness="1.35" />
                            </Grid>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="ThemeRoseMenuItem"
                              Header="绯樱流霞"
                              Tag="Theme"
                              IsCheckable="True"
                              HeaderTemplate="{StaticResource ColorThemeHeaderTemplate}"
                              Padding="{StaticResource ContextSubmenuItemPadding}"
                              Style="{StaticResource CodexMenuItemStyle}"
                              Click="OnThemeRoseClick">
                        <MenuItem.Icon>
                            <Grid Width="11.7"
                                  Height="11.7">
                                <Ellipse Stroke="{DynamicResource QuotaTrackBrush}"
                                         StrokeThickness="1.35" />
                                <controls:ProgressArc Progress="85"
                                                      Stroke="{StaticResource ThemeRosePreviewBrush}"
                                                      StrokeThickness="1.35" />
                            </Grid>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="ThemeMintMenuItem"
                              Header="薄荷清露"
                              Tag="Theme"
                              IsCheckable="True"
                              HeaderTemplate="{StaticResource ColorThemeHeaderTemplate}"
                              Padding="{StaticResource ContextSubmenuItemPadding}"
                              Style="{StaticResource CodexMenuItemStyle}"
                              Click="OnThemeMintClick">
                        <MenuItem.Icon>
                            <Grid Width="11.7"
                                  Height="11.7">
                                <Ellipse Stroke="{DynamicResource QuotaTrackBrush}"
                                         StrokeThickness="1.35" />
                                <controls:ProgressArc Progress="85"
                                                      Stroke="{StaticResource ThemeMintPreviewBrush}"
                                                      StrokeThickness="1.35" />
                            </Grid>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="ThemeForestMenuItem"
                              Header="苍林叠翠"
                              Tag="Theme"
                              IsCheckable="True"
                              HeaderTemplate="{StaticResource ColorThemeHeaderTemplate}"
                              Padding="{StaticResource ContextSubmenuItemPadding}"
                              Style="{StaticResource CodexMenuItemStyle}"
                              Click="OnThemeForestClick">
                        <MenuItem.Icon>
                            <Grid Width="11.7"
                                  Height="11.7">
                                <Ellipse Stroke="{DynamicResource QuotaTrackBrush}"
                                         StrokeThickness="1.35" />
                                <controls:ProgressArc Progress="85"
                                                      Stroke="{StaticResource ThemeForestPreviewBrush}"
                                                      StrokeThickness="1.35" />
                            </Grid>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="刷新样式"
                          controls:MenuChrome.IsRootItem="True"
                          Style="{StaticResource CodexMenuItemStyle}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource MenuRefreshStyleIcon}"
                              Style="{StaticResource CodexMenuIconStyle}" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="RefreshProgressRingMenuItem"
                              Header="进度环旋转"
                              Tag="Theme"
                              IsCheckable="True"
                              Padding="{StaticResource ContextSubmenuItemPadding}"
                              Style="{StaticResource CodexMenuItemStyle}"
                              Click="OnRefreshProgressRingClick" />
                    <MenuItem x:Name="RefreshHighlightSweepMenuItem"
                              Header="流光旋转"
                              Tag="Theme"
                              IsCheckable="True"
                              Padding="{StaticResource ContextSubmenuItemPadding}"
                              Style="{StaticResource CodexMenuItemStyle}"
                              Click="OnRefreshHighlightSweepClick" />
                    <MenuItem x:Name="RefreshDotOrbitMenuItem"
                              Header="光点巡航"
                              Tag="Theme"
                              IsCheckable="True"
                              Padding="{StaticResource ContextSubmenuItemPadding}"
                              Style="{StaticResource CodexMenuItemStyle}"
                              Click="OnRefreshDotOrbitClick" />
                </MenuItem>
                <MenuItem x:Name="PositionSettingsMenuItem"
                          Header="显示位置"
                          controls:MenuChrome.IsRootItem="True"
                          Style="{StaticResource CodexMenuItemStyle}"
                          Click="OnPositionSettingsClick">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource MenuPlacementIcon}"
                              Style="{StaticResource CodexMenuIconStyle}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="HideFiveHourMenuItem"
                          Header="隐藏 5 小时"
                          Tag="Toggle"
                          IsCheckable="True"
                          controls:MenuChrome.IsRootItem="True"
                          Style="{StaticResource CodexMenuItemStyle}"
                          Click="OnHideFiveHourClick">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource MenuHideIcon}"
                              Style="{StaticResource CodexMenuIconStyle}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="StartupMenuItem"
                          Header="开机启动"
                          Tag="Toggle"
                          IsCheckable="True"
                          controls:MenuChrome.IsRootItem="True"
                          Style="{StaticResource CodexMenuItemStyle}"
                          Click="OnStartupMenuClick">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource MenuStartupIcon}"
                              Style="{StaticResource CodexMenuFilledIconStyle}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="调试面板"
                          controls:MenuChrome.IsRootItem="True"
                          Style="{StaticResource CodexMenuItemStyle}"
                          Click="OnDebugMenuClick">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource MenuDebugIcon}"
                              Style="{StaticResource CodexMenuIconStyle}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="关于"
                          controls:MenuChrome.IsRootItem="True"
                          Style="{StaticResource CodexMenuItemStyle}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource MenuAboutIcon}"
                              Style="{StaticResource CodexMenuIconStyle}" />
                    </MenuItem.Icon>
                    <MenuItem Style="{StaticResource CodexAboutItemStyle}">
                        <MenuItem.Header>
                            <StackPanel Width="168">
                                <TextBlock Text="Codex Usage Bar"
                                           Foreground="{DynamicResource ContextMenuPrimaryTextBrush}"
                                           FontSize="13" />
                                <TextBlock Margin="0,7,0,0"
                                           TextWrapping="Wrap">
                                    <Run Text="安静显示 Codex 剩余额度与" />
                                    <LineBreak />
                                    <Run Text="重置时间。" />
                                </TextBlock>
                                <TextBlock x:Name="AboutVersionText"
                                           Margin="0,10"
                                           Foreground="{DynamicResource ContextMenuPrimaryTextBrush}" />
                                <TextBlock Text="by Wenfu Pu"
                                           Foreground="{DynamicResource ContextMenuMutedTextBrush}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </MenuItem>
                <Separator Style="{StaticResource CodexSeparatorStyle}" />
                <MenuItem Header="退出"
                          Tag="Exit"
                          controls:MenuChrome.IsRootItem="True"
                          Style="{StaticResource CodexMenuItemStyle}"
                          Click="OnExitMenuClick">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource MenuExitIcon}"
                              Style="{StaticResource CodexMenuIconStyle}" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid x:Name="WidgetContentHost">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="WidgetContentOffsetTransform" />
            </Grid.RenderTransform>
            <controls:QuotaWidgetPanel x:Name="WidgetPanel"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       Height="{Binding RingDiameterDip}">
                <controls:QuotaMeter x:Name="FiveHourMeter"
                                     DataContext="{Binding FiveHour}"
                                     IsRefreshing="{Binding DataContext.IsRefreshing,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                     RingDiameter="{Binding DataContext.RingDiameterDip, RelativeSource={RelativeSource AncestorType=Window}}" />
                <controls:AdaptiveResetText x:Name="FiveHourResetText"
                                            Text="{Binding FiveHour.ResetText}" />

                <controls:QuotaMeter x:Name="WeeklyMeter"
                                     DataContext="{Binding Weekly}"
                                     IsRefreshing="{Binding DataContext.IsRefreshing,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                     RingDiameter="{Binding DataContext.RingDiameterDip, RelativeSource={RelativeSource AncestorType=Window}}" />
                <controls:AdaptiveResetText Text="{Binding Weekly.ResetText}" />
            </controls:QuotaWidgetPanel>
        </Grid>
    </Grid>
</Window>
