<UserControl x:Class="CodexUsageBar.App.Controls.QuotaMeter"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CodexUsageBar.App.Controls"
             Width="{Binding RingDiameter, ElementName=Root}"
             Height="{Binding RingDiameter, ElementName=Root}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid>
        <Ellipse x:Name="Halo"
                 Fill="#01000000"
                 IsHitTestVisible="False"
                 Opacity="0"
                 Stroke="{DynamicResource QuotaProgressBrush}" />
        <Ellipse x:Name="Track"
                 Fill="#01000000"
                 Stroke="{DynamicResource QuotaTrackBrush}" />
        <controls:ProgressArc x:Name="Arc"
                              Progress="{Binding Progress}"
                              Opacity="{Binding ArcOpacity}"
                              RenderTransformOrigin="0.5,0.5"
                              Stroke="{DynamicResource QuotaProgressBrush}">
            <controls:ProgressArc.RenderTransform>
                <RotateTransform x:Name="ArcRotation" Angle="0" />
            </controls:ProgressArc.RenderTransform>
        </controls:ProgressArc>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Tag="Percentage"
                       Text="{Binding PercentageText}"
                       Foreground="{DynamicResource QuotaPrimaryTextBrush}"
                       FontFamily="{DynamicResource WidgetFontFamily}"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       LineHeight="12"
                       TextAlignment="Center"
                       TextTrimming="None"
                       Typography.NumeralAlignment="Tabular" />
            <TextBlock Text="{Binding Label}"
                       Foreground="{DynamicResource QuotaSecondaryTextBrush}"
                       FontFamily="{DynamicResource WidgetFontFamily}"
                       FontSize="7.5"
                       LineHeight="9"
                       TextAlignment="Center"
                       TextTrimming="None"
                       Typography.NumeralAlignment="Tabular" />
        </StackPanel>
    </Grid>
</UserControl>
